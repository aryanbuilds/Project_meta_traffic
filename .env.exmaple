# NeuroSignal India - Environment Template
# Copy this file to .env and replace placeholder values.

# Google Gemini API
# Get key: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Simulation
SIM_SEED=42
SIM_STEPS=3600
LLM_DECISION_INTERVAL=10

# Signal Timing Constraints
MIN_GREEN_S=15
MAX_GREEN_S=60
EMERGENCY_HOLD_S=30

# Computer Vision
YOLO_AMBULANCE_CONF=0.7
FRAME_SIZE=800
YOLO_INFERENCE_RATE=3

# Top-Down Render / 2D Window Tuning
TOPDOWN_AUTO_FIT=1
TOPDOWN_MAX_SCREEN_RATIO=0.65
TOPDOWN_WIDTH=800
TOPDOWN_HEIGHT=800
TOPDOWN_WINDOW=1
TOPDOWN_FILM_SCALE=1.0
# Optional: set to numeric value, e.g. 3.0
# TOPDOWN_SCALING=

# MetaDrive Runtime
METADRIVE_USE_RENDER=1
# Optional: hide interface panels for performance
# METADRIVE_SHOW_INTERFACE=0

# Backend Streaming
BROADCAST_FPS_CAP=10
API_PORT=8000
DASHBOARD_PORT=5173

# Logging
DB_PATH=data/decisions.db
LOG_LEVEL=INFO
