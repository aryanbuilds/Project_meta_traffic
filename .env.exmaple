# NeuroSignal India - Environment Template
# Copy this file to .env and replace placeholder values.

# ── OpenRouter LLM (used by inference.py for hackathon evaluation) ──
# OpenRouter provides OpenAI-compatible API for many models.
# Get a free key at: https://openrouter.ai/keys
API_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=google/gemma-4-31b-it:free
OPENAI_API_KEY=YOUR_OPENROUTER_API_KEY

# ── Hugging Face (Space deployment + inference auth) ────────────────
HF_TOKEN=YOUR_HF_TOKEN

# ── Azure OpenAI (Fallback / NeuroSignal traffic signal agent) ──────
# Example endpoint: https://<resource-or-project>.openai.azure.com
AZURE_OPENAI_ENDPOINT=YOUR_AZURE_OPENAI_ENDPOINT
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Use your deployment name, not the base model family name
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Simulation
SIM_SEED=42
SIM_STEPS=3600
LLM_DECISION_INTERVAL=10
SIM_ENV_MODE=multi_agent

# Signal Timing Constraints
MIN_GREEN_S=15
MAX_GREEN_S=60
EMERGENCY_HOLD_S=30

# Computer Vision
YOLO_AMBULANCE_CONF=0.7
FRAME_SIZE=800
YOLO_INFERENCE_RATE=3
PERCEPTION_FRAME_SOURCE=topdown
PERCEPTION_SENSOR_NAME=rgb_camera
PERCEPTION_WIDTH=640
PERCEPTION_HEIGHT=360
YELLOW_DURATION_S=5
AUTO_CYCLE_TRAFFIC_LIGHTS=0

# Top-Down Render / 2D Window Tuning
TOPDOWN_AUTO_FIT=1
TOPDOWN_MAX_SCREEN_RATIO=0.65
TOPDOWN_WIDTH=800
TOPDOWN_HEIGHT=800
TOPDOWN_WINDOW=1
TOPDOWN_FILM_SCALE=1.0
TOPDOWN_SCALING=3.0
# camera options: map_center | default
TOPDOWN_CAMERA_MODE=map_center

# MetaDrive Runtime
METADRIVE_USE_RENDER=1
# Single-agent map settings
METADRIVE_MAP=X
METADRIVE_NUM_SCENARIOS=3
# Agent policy mode: manual | idm
# Note: multi-agent works with manual or idm. In idm mode, per-agent actions are neutral [0,0]
# and control comes from IDMPolicy.
AGENT_POLICY_MODE=idm
# Lower traffic density for stable demos
TRAFFIC_DENSITY=0.3
# Keep reverse disabled to avoid unrealistic backing through red-light approaches
VEHICLE_ENABLE_REVERSE=0
# Custom ambulance visual override (best-effort OBJ attach; falls back to red vehicle color)
AMBULANCE_OBJ_PATH=Models_G0403A078/ambulance.obj
AMBULANCE_MODEL_SCALE=0.7
AMBULANCE_MODEL_Z=0.55
# Done/termination controls
CRASH_VEHICLE_DONE=0
CRASH_OBJECT_DONE=1
OUT_OF_ROAD_DONE=1
# Multi-agent settings (used when SIM_ENV_MODE=multi_agent)
MULTI_AGENT_COUNT=12
MULTI_ALLOW_RESPAWN=1
MULTI_CRASH_DONE=0
MULTI_OUT_OF_ROAD_DONE=0
MULTI_DELAY_DONE=8
INTERSECTION_EXIT_LENGTH=100
INTERSECTION_LANE_NUM=2
TRAFFIC_LIGHT_CYCLE_STEPS=140
# Optional: hide interface panels for performance
# METADRIVE_SHOW_INTERFACE=0

# Conservative IDM tuning (reduces collisions in dense multi-agent traffic)
IDM_CONSERVATIVE_MODE=1
IDM_TIME_WANTED=2.2
IDM_DISTANCE_WANTED=14
IDM_NORMAL_SPEED=18
IDM_LANE_CHANGE_FREQ=120
IDM_SAFE_LANE_CHANGE_DISTANCE=20
IDM_ENABLE_LANE_CHANGE=0
IDM_DISABLE_DECELERATION=0

# Ego Driver Baseline (single-agent)
# steering: -1..1, throttle: -1..1
DRIVER_STEER=0.0
DRIVER_THROTTLE=0.35

# Backend Streaming
BROADCAST_FPS_CAP=10
API_PORT=8000
DASHBOARD_PORT=5173

# Logging
DB_PATH=data/decisions.db
LOG_LEVEL=INFO
# Debug checkpoints for end-to-end verification (YOLO/PCE/LLM/signal apply)
PIPELINE_DEBUG=0
# Per-light signal application diagnostics
SIGNAL_DEBUG=0
# Detector failover thresholds (WinError 1114 / early failures)
DETECTOR_WINERROR_THRESHOLD=2
DETECTOR_EARLY_FAILURE_THRESHOLD=3
DETECTOR_EARLY_FAILURE_WINDOW=20
DETECTOR_WORKER_TIMEOUT_S=4.0

# Optional explicit traffic-light mapping override for deterministic signal control.
# Format is JSON: {"<light_id>":"north|south|east|west", ...}
# SIGNAL_LIGHT_DIRECTION_MAP={"north_light":"north","south_light":"south"}
SIGNAL_LIGHT_DIRECTION_MAP=

# Random Road Graph Generator
RANDOM_GRAPH_NODES=120
RANDOM_GRAPH_EDGES=320
RANDOM_GRAPH_LIGHT_PROB=0.25


